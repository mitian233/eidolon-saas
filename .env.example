# 复制为 .env 后填写。docker compose up 会把它传给后端。
#
# 平台零凭据：下面所有第三方 key 都可以不填，后端照常启动、照常服务。
# 模型、语音、向量化费用由用户自带（BYOK）：用户在浏览器设置里填自己的 key，
# key 只留在浏览器和回合/通话期间的进程内存里，平台不保存（ADR-0017）。
# 部署者也可以填自己的 key 作为兜底（用户没带时用部署者的），填了才产生平台费用。
# 有后台时（设了 EIDOLON_ADMINS，或开着开发登录），很多项也可以在网站后台里改：
# 后台改过的项优先于这里，之后再改这里的同一项不会生效，要先在后台恢复成 .env 的值。

# ── 开发登录与本地开发 ─────────────────────────────────────────────
# 填 1 时登录页多出「开发登录」，按名字直接登录（用户不存在就创建），不需要 OAuth 应用。
# 只能在本地开发时打开：它让任何人都能冒充任何用户，配置了 EIDOLON_DOMAIN 时后端拒绝启动。
# 开着它又没填 EIDOLON_ADMINS 时，所有人都是管理者，都能进 /admin 后台。
EIDOLON_DEV_LOGIN=1
# 数据库文件（可选，默认 data/eidolon.db；Docker 里固定 /data/eidolon.db，在数据卷里）
EIDOLON_DATABASE_PATH=

# ── 部署者的对话模型（可选，零 key 平台不填）──────────────────────
# 接口类型 CHAT_LLM_PROTOCOL 三选一（不填为 chat-completions）：
#   chat-completions  OpenAI 兼容的 Chat Completions 接口（请求 {地址}/chat/completions）
#   responses         OpenAI Responses 接口（请求 {地址}/responses）
#   anthropic         Anthropic Messages 接口（请求 {地址}/messages）
# 配了就要支持流式输出和工具调用：启动时发一次很小的检查请求，不满足就拒绝启动并说明原因。
# 三项（BASE_URL/API_KEY/MODEL）要么都填、要么都不填；只填一部分时后端拒绝启动。
CHAT_LLM_PROTOCOL=
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
# 每次回复的长度上限（可选，单位 token）。Anthropic 接口必须有上限，不填时为 16384。
CHAT_LLM_MAX_TOKENS=
# 思考强度（可选）：none、minimal、low、medium、high、xhigh、max 之一；不填就不发。
CHAT_LLM_REASONING_EFFORT=
# 通话里的思考强度（可选），写法同上；不填就不发，不沿用上面那一项。
CHAT_LLM_CALL_REASONING_EFFORT=
# 额外请求参数（可选）：一个 JSON 对象，深合并进每次请求，例如 {"enable_thinking": false}。
# 不能包含 model、stream、stream_options、messages、input、instructions、system、tools、tool_choice。
CHAT_LLM_EXTRA_BODY=

# 后台模型（可选）：回合结束后提炼记忆、给对话起标题用。
# 除 MAX_TOKENS/REASONING_EFFORT/EXTRA_BODY 外每一项不填都沿用对话模型的设置；对话模型也没配时就没有后台模型。
BACKGROUND_LLM_PROTOCOL=
BACKGROUND_LLM_BASE_URL=
BACKGROUND_LLM_API_KEY=
BACKGROUND_LLM_MODEL=
BACKGROUND_LLM_MAX_TOKENS=
BACKGROUND_LLM_REASONING_EFFORT=
BACKGROUND_LLM_EXTRA_BODY=

# ── 部署者的语音服务（可选；通话主要走用户自带的 key）─────────────
# 语音识别二选一（STT_PROVIDER，不填为 soniox）：soniox 用 SONIOX_API_KEY；
# bailian 用 DASHSCOPE_API_KEY（北京/新加坡地域自动判断；填了 key 但调不通时拒绝启动）。
STT_PROVIDER=
SONIOX_API_KEY=
DASHSCOPE_API_KEY=
BAILIAN_STT_MODEL=
# 语音合成（Fish Audio）。模型只能是 s2.1-pro-free、s2.1-pro、drama-3、s2-pro、s1；
# 默认 s2.1-pro-free 不消耗 API 额度。
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=

# ── 向量化与重排（可选；配了才有资料召回和记忆）───────────────────
# 向量化二选一（EMBEDDING_PROVIDER，不填为 siliconflow）：
#   siliconflow  硅基流动的 Qwen3-Embedding，用 SILICONFLOW_API_KEY
#   gemini       Google 的 Gemini Embedding 2，用 GEMINI_API_KEY（不对中国大陆开放；
#                免费层内容会被 Google 用于改进产品，公开部署介意就开通计费并填 GEMINI_BILLING_ENABLED=1）
# 重排固定在硅基流动，SILICONFLOW_API_KEY 照样要填。都没配时角色只凭人设回复，
# 资料召回退到模型自己发起的 recall_story 工具（需要向量化），记忆关闭。
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
GEMINI_API_KEY=
GEMINI_BILLING_ENABLED=
GEMINI_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
RERANK_MODEL=
# 重排阈值（可选，0 到 1）：低于它的资料（RERANK_MIN_RELEVANCE）或记忆（RERANK_MEMORY_MIN_RELEVANCE）不进提示词。
# 不填按模型取校准值：0.6B 为 0.3 / 0.01，4B 为 0.7 / 0.005。
RERANK_MIN_RELEVANCE=
RERANK_MEMORY_MIN_RELEVANCE=

# ── 判断模型（可选；检索判断、好感度、通话情绪）───────────────────
# 三选一（JUDGE_PROVIDER，不填为 jev）：jev、cloudflare、bailian。没配时不主动检索、好感度关闭。
JUDGE_PROVIDER=
# jev：TypeSafe 的 Jev，默认经 OpenRouter，填 OpenRouter 的 key。
JEV_API_KEY=
JEV_MODEL=
JEV_BASE_URL=
# cloudflare：Workers AI 上的 Clef（token 需要 Workers AI 的 Read 和 Edit 权限）。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_JUDGE_MODEL=
# bailian：阿里云百炼业务空间的决策模型（key 必须属于该业务空间，和语音识别的 DASHSCOPE_API_KEY 分开）。
BAILIAN_JUDGE_API_KEY=
BAILIAN_JUDGE_WORKSPACE_ID=
BAILIAN_JUDGE_REGION=
BAILIAN_JUDGE_MODEL=
# 通话中情绪判断的阈值（可选）：概率低于 JUDGE_EMOTION_MIN_PROBABILITY 按平静处理；
# 超过 JUDGE_EMOTION_TIMEOUT 秒（默认 1.5）没判断出来的段不换表情。
JUDGE_EMOTION_MIN_PROBABILITY=
JUDGE_EMOTION_TIMEOUT=

# ── WebRTC / TURN（可选；生产部署用 compose 自带的 coturn）────────
EIDOLON_ICE_SERVERS=
EIDOLON_TURN_URLS=
EIDOLON_TURN_SECRET=

# ── 限额（可选）───────────────────────────────────────────────────
# 每位用户每小时的文字回合和通话次数（默认 60 / 5，0 不限）。
# 用自带 LLM 的文字回合、带齐免限额密钥的通话不计入。
EIDOLON_TURNS_PER_HOUR=
EIDOLON_CALLS_PER_HOUR=
# 单通通话的时长上限（分钟）和回合上限（默认 10 / 40，0 不限）；同时进行的通话数（默认 10，0 不限）。
EIDOLON_CALL_MINUTES=
EIDOLON_TURNS_PER_CALL=
EIDOLON_CONCURRENT_CALLS=
# 免限额密钥：通话把选上的几项都用了自带密钥就不计入限额（默认三项都选，至少选一项）。
EIDOLON_EXEMPTING_LLM=
EIDOLON_EXEMPTING_TTS=
EIDOLON_EXEMPTING_STT=
# 每个回合发给模型的历史回合数下限（默认 20，0 为整段对话）。
EIDOLON_HISTORY_TURNS=
# 好感度（可选，默认 1 开；0 关）。需要判断模型；没配判断模型时整块关闭。礼物玩法待后续里程碑。
EIDOLON_AFFINITY_AND_GIFTS=

# ── 网络代理（可选）───────────────────────────────────────────────
# EIDOLON_PROXY_URL：http://、https://、socks5://、socks5h:// 开头，可带用户名密码。
# EIDOLON_PROXY_SERVICES：走代理的服务，逗号分隔：chat_llm、memory_llm、judge、embedding、rerank、
# tts、stt、image、gpt_image，用户自带的 own_llm、own_tts、own_stt、own_image，或 all。
# 自带 LLM 只在地址属于已知服务商时才走代理。HTTPS_PROXY 等变量对这几项不起作用。
EIDOLON_PROXY_URL=
EIDOLON_PROXY_SERVICES=

# ── 服务状态（可选）───────────────────────────────────────────────
# 给用户看各项服务正不正常：EIDOLON_STATUS_SERVICES 逗号分隔（chat_llm…image，all/none），
# EIDOLON_STATUS_WINDOW_MINUTES 统计最近 10/30/60 分钟（默认 30）。没配的服务自动不显示。
EIDOLON_STATUS_SERVICES=
EIDOLON_STATUS_WINDOW_MINUTES=

# ── 登录与管理（生产部署；本地开发用上面的开发登录）───────────────
# GitHub 或 Google 登录，至少配一家；回调地址见 docs/deploy.md。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 加密后台保存的 key、给封禁名单做哈希的密钥：openssl rand -hex 32 生成；填了之后不要更换。
# 用户的自带密钥只存在浏览器里，跟它无关（ADR-0017）。
EIDOLON_SECRET_KEY=
# 管理者：逗号分隔的「提供方:身份标识」，例如 github:12345。先登录一次，再 eidolon user list 查标识。
# 不填时后台不存在（开着开发登录时除外）。
EIDOLON_ADMINS=
# 联系方式（可选）：被封禁的用户、没有邀请链接被挡下的人看到的联系渠道。
EIDOLON_CONTACT=
# 注册方式（可选）：open（默认）谁都能注册；invite 只让受邀的人注册（要配好管理者名单）。
EIDOLON_REGISTRATION=

# ── 素材外链（可选）───────────────────────────────────────────────
# 角色头像、立绘等素材一律外链，平台不托管文件（D11）。
# 立绘素材的公开访问地址（S3 兼容存储桶的 URL，要公开可读、配 CORS）；不填时通话只显示背景。
EIDOLON_STAND_ASSETS_URL=

# ── 数据库备份（可选；deploy/db-backup.sh 每天运行 eidolon backup）──
# 私有 S3 兼容存储桶（推荐 Cloudflare R2），不要开公开访问。
EIDOLON_BACKUP_S3_ENDPOINT=
EIDOLON_BACKUP_S3_BUCKET=
EIDOLON_BACKUP_S3_ACCESS_KEY_ID=
EIDOLON_BACKUP_S3_SECRET_ACCESS_KEY=
EIDOLON_BACKUP_S3_REGION=
EIDOLON_BACKUP_S3_ADDRESSING=
# 加密备份的 age 公钥（age1 开头）。服务器上只放公钥；私钥离线保存，丢了备份就解不开。
EIDOLON_BACKUP_AGE_RECIPIENT=
# 心跳地址（可选）：备份成功后访问一次，例如 healthchecks.io。
EIDOLON_BACKUP_PING_URL=
# 保留期（可选，1–30 天，默认 30）；空间提醒（可选，GB）。
EIDOLON_BACKUP_KEEP_DAYS=
EIDOLON_BACKUP_WARN_GB=
EIDOLON_BACKUP_LOG=

# ── 生产部署（docker-compose.prod.yml，步骤见 docs/deploy.md）─────
# 域名（A 记录指向这台服务器，Caddy 自动申请证书）；本地开发不要填。
EIDOLON_DOMAIN=
# 服务器的公网 IPv4：coturn 只允许把语音中继到这台服务器。
EIDOLON_PUBLIC_IP=
# 网卡上的内网地址（可选）：公网地址不在网卡上时（1:1 NAT 云主机）才填。
EIDOLON_PRIVATE_IP=
# coturn 中继端口范围（可选，默认 49160-49259，防火墙放行这些 UDP 端口）。
EIDOLON_TURN_MIN_PORT=
EIDOLON_TURN_MAX_PORT=
# 前后端用 GHCR 上的哪一版镜像（可选，默认 main 最新）。
EIDOLON_IMAGE_TAG=